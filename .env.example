# PatchPilot 配置模板：复制为 .env 后按需修改
# 所有变量均以 PP_ 前缀，由 pydantic-settings 读取

# ---------- 基础 ----------
PP_ENV=dev
PP_LOG_LEVEL=INFO
PP_LOG_JSON=true

# ---------- 编排 / checkpoint ----------
# memory   : 进程内存，零依赖，用于 smoke 与单测
# sqlite   : 本地文件持久化，PC 单机开发推荐（需 pip install -e ".[sqlite]"）
# postgres : 生产形态，需要 docker compose 起 postgres（需 pip install -e ".[postgres]"）
PP_CHECKPOINT_BACKEND=memory
PP_SQLITE_PATH=.patchpilot/checkpoints.sqlite
# 本地 docker compose 的默认账号为 patchpilot / patchpilot，请把 <user>/<password> 替换掉
PP_POSTGRES_DSN=postgresql://<user>:<password>@localhost:5432/patchpilot

# ---------- 依赖服务 ----------
PP_REDIS_URL=redis://localhost:6379/0
PP_QDRANT_URL=http://localhost:6333

# ---------- 模型（纯 API 路线，不部署本地模型）----------
# stub              : 不调用网络，返回确定性结果，用于骨架自测
# deepseek / qwen / openai_compatible : OpenAI 兼容协议
PP_LLM_PROVIDER=stub
PP_LLM_BASE_URL=https://api.deepseek.com/v1
PP_LLM_API_KEY=
PP_LLM_MODEL=deepseek-chat
PP_LLM_SMALL_MODEL=deepseek-chat

# 价格覆盖（可选）：新模型未收录进内置价格表时填这里，否则成本不参与金额熔断
# 形如 {"deepseek-v3": [0.3, 1.2]}，单位为「美元 / 每百万 token」的 (输入, 输出)
# PP_PRICE_OVERRIDES={"deepseek-v3": [0.3, 1.2]}

# ---------- 预算：四重硬上限（任一触顶即熔断）----------
# 取 0 表示该项不限制；四项不能同时为 0，否则任务无法终止
PP_BUDGET_MAX_TOKENS=200000
PP_BUDGET_MAX_USD=2.0
PP_BUDGET_MAX_SECONDS=900
PP_BUDGET_MAX_ATTEMPTS=3

# ---------- 可观测 ----------
PP_TRACE_DIR=.patchpilot/traces

# ---------- 门禁 ----------
# pytest 临时目录；受限环境（如沙箱）请指向可写位置，否则会误报失败
# PP_CHECK_BASETEMP=.patchpilot/pytest-tmp
